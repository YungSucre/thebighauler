---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { CATEGORIES } from "../config";
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";

const articles = await getCollection("articles", ({ data }) => data.status === "published");
const sorted = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const seenHashes = new Set();
const latest: typeof sorted = [];
for (const a of sorted) {
  if (latest.length >= 6) break;
  const img = a.data.hero_image || "";
  if (!img) continue;
  if (!img.startsWith("http")) {
    try {
      const buf = readFileSync("public" + img);
      const h = createHash("md5").update(buf).digest("hex");
      if (seenHashes.has(h)) continue;
      seenHashes.add(h);
    } catch {
      /* fichier introuvable : on garde quand même */
    }
  }
  latest.push(a);
}
const byVertical = {};
const lastByVertical = {};
for (const a of articles) {
  byVertical[a.data.vertical] = (byVertical[a.data.vertical] || 0) + 1;
  const prev = lastByVertical[a.data.vertical];
  if (!prev || a.data.pubDate.valueOf() > prev.data.pubDate.valueOf()) {
    lastByVertical[a.data.vertical] = a;
  }
}
const total = articles.length;
const nVertical = CATEGORIES.reduce((n, c) => n + c.verticals.length, 0);
const year = new Date().getFullYear();
const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" }).format(d);
---

<BaseLayout title="The Big Hauler: Straight Answers for Truck Drivers & Owner-Operators" description="ELD compliance, dispatch, maintenance, fuel, insurance, factoring, CDL, and the business side of trucking. Plain-language guides for drivers and owner-operators, checked and dated.">
  <section class="hero">
    <div class="hero-band">
      <span class="eyebrow">Built for the road</span>
      <h1>Straight answers for the road.</h1>
      <p class="lead">
        Plain-language guides on ELD rules, dispatch, maintenance, fuel, insurance, and running the business side of a truck. Written for drivers and owner-operators.
      </p>
      <div class="hero-ctas">
        <a class="btn" href="#topics">Find your topic</a>
        <a class="btn btn-ghost" href="#guides">Latest guides</a>
      </div>
      <form class="hero-search" action="/search/" method="get" role="search">
        <input name="q" type="search" placeholder="e.g. ELD exemptions, factoring, pre-trip…" autocomplete="off" aria-label="Search guides" />
        <button type="submit" class="btn btn-sm">Search</button>
      </form>
      <p class="hero-proof">{total} guides · {nVertical} topics · updated {year}</p>
    </div>
    <img class="hero-band-img" src="/images/hero-home.jpg" alt="Semi truck on a scenic highway" loading="eager" />
  </section>

  <div class="stats-bar">
    <div class="stat"><b>{nVertical}</b><span>trucking topics</span></div>
    <div class="stat"><b>{total}</b><span>guides published</span></div>
    <div class="stat"><b>{year}</b><span>all guides reviewed</span></div>
  </div>

  <section id="topics" style="margin-top:2.5rem;">
    <h2>Pick your topic</h2>
    <p class="lead" style="margin-bottom:1rem;">Driver, owner-operator, or fleet manager: jump straight to the guides for your side of the industry.</p>
    <nav class="family-chips" aria-label="Topic families">
      {CATEGORIES.map((cat) => (
        <a href={`#family-${cat.id}`}>{cat.name}</a>
      ))}
    </nav>
    {CATEGORIES.map((cat) => (
      <div id={`family-${cat.id}`} style="margin-top:2rem;scroll-margin-top:6rem;">
        <h3 style="margin-bottom:0.75rem;">{cat.name}</h3>
        <div class="vertical-row">
          {cat.verticals.map((v) => {
            const count = byVertical[v.id] || 0;
            const last = lastByVertical[v.id];
            return (
              <a class="vertical-card" href={`/guides/${v.id}/`}>
                {last && last.data.hero_image && (
                  <img class="thumb" src={last.data.hero_image} alt="" loading="lazy" />
                )}
                <div class="vc-body">
                  <h3>{v.name}</h3>
                  <p>{count === 0 ? "Guides coming soon." : `${count} guide${count > 1 ? "s" : ""}`}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    ))}
  </section>

  <section id="guides" style="margin-top:3rem;">
    <h2>Latest guides</h2>
    {total === 0 && (
      <div class="card"><strong>Launching soon.</strong> Our first guides are being prepared.</div>
    )}
    <div class="grid">
      {latest.map((a) => (
        <article class="article-card has-thumb">
          {a.data.hero_image && (
            <a href={`/guides/${a.data.vertical}/${a.data.slug}/`}><img class="thumb" src={a.data.hero_image} alt={a.data.hero_alt || a.data.title} loading="lazy" /></a>
          )}
          <div class="card-body">
            <span class="tag">{a.data.verticalName}</span>
            <h3><a href={`/guides/${a.data.vertical}/${a.data.slug}/`}>{a.data.title}</a></h3>
            <p class="excerpt">{a.data.description}</p>
            <p class="date">{fmtDate(a.data.pubDate)}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section style="margin-top:3rem;">
    <h2>Why drivers trust these guides</h2>
    <div class="why-grid">
      <div class="why-card">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12l2 2 4-4" /><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z" /></svg>
        <h3>Straight answers, no fluff</h3>
        <p>Every guide answers one concrete question: which ELD to buy, how to file IFTA, what insurance you actually need. No recycled filler.</p>
      </div>
      <div class="why-card">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 10h18" /></svg>
        <h3>Checked and dated</h3>
        <p>Rules change. Every guide carries a review date and realistic current figures, so you are not acting on stale information.</p>
      </div>
      <div class="why-card">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5a2 2 0 012-2h12a2 2 0 012 2v14" /><path d="M2 19h20" /><path d="M9 7h6M9 11h6M9 15h4" /></svg>
        <h3>Built for your side of the road</h3>
        <p>From solo drivers to owner-operators to small fleets, the guides are tailored to how each one actually operates.</p>
      </div>
    </div>
  </section>

  <section class="section-soft">
    <h3 style="margin-top:0;">Who we write for</h3>
    <p style="margin-bottom:0;">
      If you drive a truck for a living, or you are planning to, you face a specific set of problems: staying compliant, finding and booking loads, keeping the rig on the road, and making the numbers work. We answer those questions with concrete, current information, checked and dated on every guide.
    </p>
  </section>
</BaseLayout>
