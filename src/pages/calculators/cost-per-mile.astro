---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config";
import { DIESEL_PRICES, DIESEL_UPDATED, DEFAULT_COSTS, IRS_RATE_2026_H2, IRS_SOURCE } from "../../data/cpm-data";

const updated = "August 22, 2026";
---

<BaseLayout
  title="Cost Per Mile Calculator (2026): Trucking CPM by Region + IRS Rate"
  description="Calculate your real trucking cost per mile: diesel price by region (EIA weekly data), maintenance, insurance, payments, and driver pay. Compare your CPM to the 2026 IRS standard mileage rate."
  canonical={`${SITE.url}/calculators/cost-per-mile/`}
>
  <div class="calc-hero">
    <div class="container">
      <span class="eyebrow">Free Trucking Calculator</span>
      <h1>Cost Per Mile Calculator</h1>
      <p class="lead">
        Know your <strong>real cost per mile</strong> before you price a load. Enter
        your numbers (or keep the industry averages), pick your region for the
        <strong>official EIA diesel price</strong>, and see your true CPM — compared
        against the 2026 IRS standard mileage rate.
      </p>
      <div class="updated-badge" title="Diesel: EIA weekly survey 8/17/2026 · Costs: ATA industry averages">
        ⚡ Updated {updated} · diesel {DIESEL_UPDATED} · free forever
      </div>
    </div>
  </div>

  <div class="container calc-body">
    <!-- INPUTS -->
    <section class="calc-card">
      <h2>Your operation</h2>
      <div class="form-grid">
        <label>
          Miles per month
          <input id="miles" type="number" inputmode="decimal" min="0" step="1" value="10000" />
        </label>
        <label>
          Average MPG
          <input id="mpg" type="number" inputmode="decimal" min="1" step="0.1" value={DEFAULT_COSTS.fuelMpg} />
        </label>
        <label>
          Diesel price region
          <select id="region">
            {DIESEL_PRICES.map((d) => (
              <option value={d.price} label={`${d.label} — $${d.price.toFixed(3)}`}></option>
            ))}
          </select>
        </label>
      </div>
      <p class="hint" id="regionNote">Diesel: {DIESEL_UPDATED}</p>
    </section>

    <section class="calc-card">
      <h2>Costs per mile</h2>
      <p class="hint">Pre-filled with ATA industry averages — adjust to your operation.</p>
      <div class="form-grid">
        <label>Maintenance &amp; repairs ($/mi)<input id="maintenance" type="number" inputmode="decimal" min="0" step="0.01" value={DEFAULT_COSTS.maintenance} /></label>
        <label>Insurance ($/mi)<input id="insurance" type="number" inputmode="decimal" min="0" step="0.01" value={DEFAULT_COSTS.insurance} /></label>
        <label>Truck &amp; trailer payments ($/mi)<input id="payments" type="number" inputmode="decimal" min="0" step="0.01" value={DEFAULT_COSTS.payments} /></label>
        <label>Tires ($/mi)<input id="tires" type="number" inputmode="decimal" min="0" step="0.01" value={DEFAULT_COSTS.tires} /></label>
        <label>Tolls, permits, licenses ($/mi)<input id="misc" type="number" inputmode="decimal" min="0" step="0.01" value={DEFAULT_COSTS.misc} /></label>
        <label>Driver pay / your income ($/mi)<input id="driverPay" type="number" inputmode="decimal" min="0" step="0.01" value={DEFAULT_COSTS.driverPay} /></label>
      </div>
    </section>

    <!-- RESULTS -->
    <section class="calc-card" id="results">
      <h2>Your cost per mile</h2>
      <div class="result-summary">
        <div class="r-box">
          <span class="r-label">Fuel cost / mile</span>
          <span class="r-value" id="rFuel">$0.00</span>
        </div>
        <div class="r-box">
          <span class="r-label">All other costs / mile</span>
          <span class="r-value" id="rFixed">$0.00</span>
        </div>
        <div class="r-box r-box-main">
          <span class="r-label">Total cost per mile</span>
          <span class="r-value" id="rTotal">$0.00</span>
        </div>
        <div class="r-box">
          <span class="r-label">IRS 2026 rate (H2)</span>
          <span class="r-value" id="rIrs">$0.76</span>
        </div>
      </div>
      <div class="compare" id="compareBox">
        <p id="compareText"></p>
      </div>
      <div class="table-wrap">
        <table class="calc-table">
          <thead>
            <tr><th>Line item</th><th>Per mile</th><th>Per month</th></tr>
          </thead>
          <tbody id="resultBody"></tbody>
        </table>
      </div>
      <p class="note">
        Diesel: {DIESEL_UPDATED} (EIA). Costs: ATA industry averages, adjustable.
        IRS rate: {IRS_SOURCE}.
      </p>
    </section>
  </div>

  <!-- CONTENU ÉDITORIAL (SEO) -->
  <div class="container">
    <section class="editorial">
      <h2>Why cost per mile is the number that decides if you make money</h2>
      <p>
        Owner-operators and small fleets price loads by the mile, but most never
        calculate what a mile actually costs them. The gap between the two — your rate
        per mile and your cost per mile — is your margin. If you run 100,000 miles a
        year and your real CPM is $2.10 while you accept loads at $2.00, you are losing
        $10,000 a year before you ever touch the money. This calculator makes that
        number concrete.
      </p>
      <p>
        The calculator uses the standard industry formula: fuel (miles ÷ MPG × diesel
        price), plus maintenance, insurance, truck payments, tires, tolls and permits,
        and driver pay — all expressed per mile. The inputs are pre-filled with
        industry averages (ATA) so you can see a realistic baseline, then adjust each
        line to your own operation.
      </p>

      <h2>How to use the results</h2>
      <ul>
        <li>
          <strong>Rate per mile vs CPM:</strong> if you are paid $2.25/mile and your CPM
          is $1.95, your margin is $0.30/mile. On 10,000 miles a month that is $3,000.
        </li>
        <li>
          <strong>The IRS benchmark:</strong> the IRS standard mileage rate for business
          use is {`$${IRS_RATE_2026_H2.toFixed(2)}`}/mile (July–Dec 2026). If your
          calculated CPM is below the IRS rate, you are likely underestimating your
          costs — the IRS figure reflects what an average vehicle actually costs to run.
        </li>
        <li>
          <strong>Deadhead matters:</strong> if you run empty on 15% of miles, add 15%
          to your CPM before pricing. Many owner-operators price only loaded miles and
          quietly lose money on empty return trips.
        </li>
      </ul>

      <h2>Diesel prices by region (EIA, August 17 2026)</h2>
      <p>
        Fuel is the single largest line item, and diesel prices differ sharply by
        region. The dropdown uses the latest EIA weekly survey:
      </p>
      <div class="table-wrap">
        <table class="ref-table">
          <thead><tr><th>Region</th><th>Diesel $/gal</th></tr></thead>
          <tbody>
            {DIESEL_PRICES.map((d) => (
              <tr><td>{d.label}</td><td>${d.price.toFixed(3)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>Frequently asked questions</h2>
      <div class="faq">
        <details>
          <summary>What is a realistic cost per mile for a semi truck in 2026?</summary>
          <p>
            With diesel around $5.45/gal nationally and a typical class 8 OTR operation,
            most owner-operators are between $1.85 and $2.30 per mile all-in when you
            include driver pay. The IRS 2026 standard mileage rate of 76 cents/mile
            covers only vehicle operating costs — it does not include driver pay or
            profit, which is why your real CPM is higher.
          </p>
        </details>
        <details>
          <summary>Should I include my own driver pay as an owner-operator?</summary>
          <p>
            Yes. If you do not pay yourself a wage in the calculation, your CPM looks
            artificially low and you may accept unprofitable loads. Count your income as
            a per-mile cost so the calculator shows your true break-even.
          </p>
        </details>
        <details>
          <summary>How do I reduce my cost per mile?</summary>
          <p>
            The biggest levers in order: fuel economy (idle less, keep speeds at
            62-65 mph, check tire pressure), empty miles (deadhead), maintenance
            discipline (preventive beats breakdowns), and insurance shopping at renewal.
          </p>
        </details>
        <details>
          <summary>What is the IRS standard mileage rate for 2026?</summary>
          <p>
            The IRS business standard mileage rate is 76 cents/mile for July 1 – December
            31, 2026, and 72.5 cents/mile for January 1 – June 30, 2026 (IR-2026-29).
            Heavy trucks often use actual expenses instead, but the standard rate is a
            useful benchmark for your baseline costs.
          </p>
        </details>
        <details>
          <summary>Does this calculator include IFTA taxes?</summary>
          <p>
            IFTA fuel taxes are included implicitly in the diesel price you select (the
            EIA price includes fuel taxes at the pump). Permits and licenses are in the
            "Tolls, permits, licenses" line. For a per-state IFTA estimate, use our
            separate IFTA calculator.
          </p>
        </details>
      </div>
    </section>
  </div>

  <!-- METHODOLOGY -->
  <div class="container">
    <section class="method">
      <h2>Methodology &amp; sources</h2>
      <p>
        Diesel prices: <strong>EIA Weekly On-Highway Diesel Prices</strong>, release of
        {` ${DIESEL_UPDATED}`} (U.S. Energy Information Administration, eia.gov).
        Industry cost averages: <strong>ATA American Trucking Trends</strong> (class 8
        OTR operations). IRS rate: <strong>{IRS_SOURCE}</strong>. All figures are in US
        dollars per mile or per gallon.
      </p>
      <p class="disclaimer">
        This calculator is a planning tool, not accounting or tax advice. Your actual
        costs depend on your equipment, routes, and market conditions. Always keep
        records of your real expenses.
      </p>
    </section>
  </div>

  <style>
    .calc-hero { background: linear-gradient(120deg, #1c2a3a 0%, #2c4a63 70%, #3a6390 100%); color: #fff; padding: 2.2rem 0 2rem; border-radius: 14px; margin: 0 0 1.6rem; }
    .calc-hero .container { max-width: 900px; margin: 0 auto; padding: 0 1.2rem; }
    .calc-hero .eyebrow { display: inline-block; background: rgba(255,255,255,.14); color: #ffd9a0; font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; padding: .3rem .7rem; border-radius: 6px; margin-bottom: .8rem; }
    .calc-hero h1 { font-size: clamp(1.7rem, 4vw, 2.4rem); margin: 0 0 .6rem; line-height: 1.15; }
    .calc-hero .lead { font-size: 1.02rem; color: #e2ecf5; max-width: 680px; margin: 0 0 1rem; line-height: 1.55; }
    .updated-badge { display: inline-block; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.25); color: #eaf4fb; font-size: .82rem; padding: .35rem .8rem; border-radius: 8px; }
    .calc-body { max-width: 900px; margin: 0 auto; padding: 0 1.2rem; }
    .calc-card { background: #fff; border: 1px solid #dfe4ea; border-radius: 12px; padding: 1.4rem 1.5rem; margin-bottom: 1.2rem; box-shadow: 0 1px 3px rgba(0,0,0,.05); }
    .calc-card h2 { margin: 0 0 .9rem; font-size: 1.2rem; }
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: .9rem; }
    .form-grid label { font-size: .85rem; font-weight: 600; color: #333; }
    .form-grid input, .form-grid select { display: block; width: 100%; margin-top: .3rem; padding: .6rem .8rem; font-size: .95rem; border: 2px solid #c9d2dc; border-radius: 8px; font-family: inherit; background: #fff; }
    .form-grid input:focus, .form-grid select:focus { outline: none; border-color: #2c4a63; }
    .hint { color: #6b6a63; font-size: .82rem; margin: .6rem 0 0; }
    .result-summary { display: flex; gap: .8rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .r-box { flex: 1 1 160px; background: #f3f7fb; border: 1px solid #d8e3ee; border-radius: 10px; padding: .9rem 1rem; text-align: center; }
    .r-box-main { background: #1c2a3a; border-color: #1c2a3a; }
    .r-label { display: block; font-size: .75rem; color: #4a6a85; font-weight: 600; }
    .r-box-main .r-label { color: #a8c4dd; }
    .r-value { display: block; font-size: 1.35rem; font-weight: 800; color: #1c2a3a; margin: .25rem 0; }
    .r-box-main .r-value { color: #ffb85c; }
    .compare { background: #fdf6ec; border: 1px solid #f0ddc0; border-radius: 10px; padding: .8rem 1rem; margin-bottom: 1rem; font-size: .92rem; color: #5a4a2a; }
    .table-wrap { overflow-x: auto; }
    .calc-table, .ref-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
    .calc-table th, .ref-table th { text-align: left; background: #f0f2f5; padding: .55rem .7rem; font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; color: #4a4a44; }
    .calc-table td, .ref-table td { padding: .5rem .7rem; border-bottom: 1px solid #eceff2; }
    .note { color: #55544e; font-size: .82rem; margin: .8rem 0 0; line-height: 1.5; }
    .editorial { max-width: 900px; margin: 0 auto 2rem; padding: 0 1.2rem; }
    .editorial h2 { font-size: 1.25rem; margin: 2rem 0 .7rem; }
    .editorial p, .editorial li { font-size: .95rem; color: #3d3d38; line-height: 1.65; }
    .editorial ul { padding-left: 1.3rem; }
    .faq details { border: 1px solid #dfe4ea; border-radius: 10px; padding: .8rem 1rem; margin-bottom: .6rem; background: #fff; }
    .faq summary { font-weight: 700; cursor: pointer; color: #1c2a3a; font-size: .95rem; }
    .faq details p { margin: .6rem 0 0; font-size: .9rem; color: #55544e; line-height: 1.6; }
    .method { max-width: 900px; margin: 0 auto 2rem; padding: 0 1.2rem; }
    .method p { font-size: .92rem; color: #3d3d38; line-height: 1.6; }
    .disclaimer { font-size: .82rem; color: #7a7870; font-style: italic; }
  </style>

  <script>
    import { computeCpm } from "../../lib/cpm";

    const $ = (id: string) => document.getElementById(id)!;
    const inputs = ["miles", "mpg", "maintenance", "insurance", "payments", "tires", "misc", "driverPay"];
    inputs.forEach((id) => $(id).addEventListener("input", recalc));
    $("region").addEventListener("change", () => {
      $("regionNote").textContent = `Diesel: ${$("region").selectedOptions[0].text}`;
      recalc();
    });

    function recalc() {
      const i = {
        milesPerMonth: parseFloat($("miles").value) || 0,
        mpg: parseFloat($("mpg").value) || 0,
        dieselPrice: parseFloat($("region").value) || 5.454,
        maintenance: parseFloat($("maintenance").value) || 0,
        insurance: parseFloat($("insurance").value) || 0,
        payments: parseFloat($("payments").value) || 0,
        tires: parseFloat($("tires").value) || 0,
        misc: parseFloat($("misc").value) || 0,
        driverPay: parseFloat($("driverPay").value) || 0,
      };
      const r = computeCpm(i);
      $("rFuel").textContent = `$${r.fuelCostPerMile.toFixed(2)}`;
      $("rFixed").textContent = `$${r.fixedCostPerMile.toFixed(2)}`;
      $("rTotal").textContent = `$${r.totalCostPerMile.toFixed(2)}`;
      $("rIrs").textContent = `$${r.irsRate.toFixed(2)}`;
      // comparaison vs IRS
      const cmp = document.getElementById("compareText")!;
      if (r.totalCostPerMile > r.irsRate) {
        cmp.textContent = `Your CPM ($${r.totalCostPerMile.toFixed(2)}) is above the IRS 2026 rate ($${r.irsRate.toFixed(2)}/mi) — expected, since the IRS rate covers vehicle costs only, not driver pay. Your margin on a $2.25/mi load: $${(2.25 - r.totalCostPerMile).toFixed(2)}/mi.`;
      } else {
        cmp.textContent = `Your CPM ($${r.totalCostPerMile.toFixed(2)}) is at or below the IRS rate — double-check that you included driver pay, tolls, and realistic maintenance.`;
      }
      // tableau des lignes
      const rows: [string, number][] = [
        ["Fuel", r.fuelCostPerMile],
        ["Maintenance & repairs", i.maintenance],
        ["Insurance", i.insurance],
        ["Truck & trailer payments", i.payments],
        ["Tires", i.tires],
        ["Tolls, permits, licenses", i.misc],
        ["Driver pay / your income", i.driverPay],
      ];
      const body = $("resultBody");
      body.innerHTML = "";
      for (const [name, perMile] of rows) {
        body.insertAdjacentHTML("beforeend", `
          <tr>
            <td>${name}</td>
            <td>$${perMile.toFixed(3)}</td>
            <td>$${(perMile * i.milesPerMonth).toFixed(2)}</td>
          </tr>`);
      }
      body.insertAdjacentHTML("beforeend", `
        <tr style="font-weight:800;background:#f7f9fb;">
          <td>Total</td>
          <td>$${r.totalCostPerMile.toFixed(3)}</td>
          <td>$${r.monthlyTotal.toFixed(2)}</td>
        </tr>`);
    }
    recalc();
  </script>

  <!-- JSON-LD FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is a realistic cost per mile for a semi truck in 2026?", "acceptedAnswer": { "@type": "Answer", "text": "With diesel around $5.45/gal nationally and a typical class 8 OTR operation, most owner-operators run between $1.85 and $2.30 per mile all-in including driver pay. The IRS 2026 standard mileage rate of 76 cents/mile covers only vehicle operating costs." } },
      { "@type": "Question", "name": "Should I include my own driver pay as an owner-operator?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. If you do not pay yourself a wage in the calculation, your CPM looks artificially low and you may accept unprofitable loads. Count your income as a per-mile cost." } },
      { "@type": "Question", "name": "How do I reduce my cost per mile?", "acceptedAnswer": { "@type": "Answer", "text": "The biggest levers in order: fuel economy (idle less, 62-65 mph, tire pressure), empty miles (deadhead), preventive maintenance, and insurance shopping at renewal." } },
      { "@type": "Question", "name": "What is the IRS standard mileage rate for 2026?", "acceptedAnswer": { "@type": "Answer", "text": "The IRS business standard mileage rate is 76 cents/mile for July 1 - December 31, 2026, and 72.5 cents/mile for January 1 - June 30, 2026 (IR-2026-29)." } },
      { "@type": "Question", "name": "Does this calculator include IFTA taxes?", "acceptedAnswer": { "@type": "Answer", "text": "IFTA fuel taxes are included implicitly in the EIA diesel price, which includes fuel taxes at the pump. Permits and licenses are in the tolls/permits line item." } }
    ]
  })} />
</BaseLayout>
